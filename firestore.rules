rules_version = '2';

// VitalAI - Reglas de seguridad de Cloud Firestore
//
// Cada usuario solo puede leer y escribir su propio documento
// usuarios/{uid} y todo lo que cuelga de el (registros diarios,
// entrenamiento semanal y configuracion). Cualquier otra ruta se rechaza.
//
// Publicar: Firebase Console -> Firestore Database -> Reglas -> pegar y Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
